services:
  # Nginx 反向代理
  nginx:
    image: nginx:alpine
    container_name: kanban_nginx
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      - frontend
      - backend
    restart: unless-stopped
    networks:
      - kanban_network

  # 前端
  frontend:
    build:
      context: ../frontend
      dockerfile: Dockerfile
    image: kanban-frontend:latest
    container_name: kanban_frontend
    environment:
      - NODE_ENV=production
    restart: unless-stopped
    networks:
      - kanban_network

  # 后端
  backend:
    build:
      context: ../backend
      dockerfile: Dockerfile
    image: kanban-backend:latest
    container_name: kanban_backend
    environment:
      - PORT=5002
      # 连接 VPS 系统的 PostgreSQL（使用 host.docker.internal 或 VPS IP）
      - DATABASE_URL=postgresql://your_vps_user:your_vps_password@host.docker.internal:5432/your_db_name
      - NODE_ENV=production
    restart: unless-stopped
    networks:
      - kanban_network
    # 允许访问宿主机网络
    extra_hosts:
      - "host.docker.internal:host-gateway"

  # 如果使用 VPS PostgreSQL，就不需要这个容器了
  # postgres:
  #   image: postgres:16
  #   ...

networks:
  kanban_network:
    driver: bridge
