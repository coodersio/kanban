services:
  # 前端 - 直接暴露 5001 端口
  frontend:
    build:
      context: ../frontend
      dockerfile: Dockerfile
    image: kanban-frontend:latest
    container_name: kanban_frontend
    ports:
      - "5001:5001"  # ✅ 直接暴露到 VPS
    environment:
      - NODE_ENV=production
    restart: unless-stopped
    networks:
      - kanban_network

  # 后端 - 直接暴露 5002 端口
  backend:
    build:
      context: ../backend
      dockerfile: Dockerfile
    image: kanban-backend:latest
    container_name: kanban_backend
    ports:
      - "5002:5002"  # ✅ 直接暴露到 VPS
    environment:
      - PORT=5002
      - DATABASE_URL=postgresql://kanban_user:${POSTGRES_PASSWORD:-kanban_password}@postgres:5432/kanban_db
      - NODE_ENV=production
    depends_on:
      - postgres
    restart: unless-stopped
    networks:
      - kanban_network

  # PostgreSQL 数据库
  postgres:
    image: postgres:16
    container_name: kanban_postgres
    environment:
      POSTGRES_DB: kanban_db
      POSTGRES_USER: kanban_user
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-kanban_password}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    restart: unless-stopped
    networks:
      - kanban_network

volumes:
  postgres_data:

networks:
  kanban_network:
    driver: bridge
