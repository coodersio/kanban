name: Deploy to VPS

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  deploy:
    runs-on: self-hosted  # 使用 VPS 上的 self-hosted runner

    steps:
      - name: Deploy with Docker Compose
        run: |
          echo "========================================="
          echo "开始部署 KanBan 项目"
          echo "========================================="

          # 进入项目目录
          cd /opt/kanban

          # 拉取最新代码
          echo "1/5 拉取最新代码..."
          git pull origin main

          # 进入 deploy 目录
          cd deploy

          # 停止旧容器
          echo "2/5 停止旧容器..."
          docker compose down

          # 构建新镜像
          echo "3/5 构建新镜像..."
          docker compose build --no-cache

          # 启动新容器
          echo "4/5 启动新容器..."
          docker compose up -d

          # 等待后端启动
          echo "等待后端启动..."
          sleep 10

          # 运行数据库迁移
          echo "5/5 运行数据库迁移..."
          docker compose exec -T backend npm run migrate:up || echo "迁移失败或无新迁移"

          # 清理无用镜像
          echo "清理无用镜像..."
          docker image prune -f

          echo "========================================="
          echo "部署完成！"
          echo "========================================="

          # 显示运行状态
          docker compose ps
